/.cursor/mcp.json
/.cursor/mcp-auth.json
/.config/devin/
/.config/opencode/
/.grok/

# Device-local skill manager lock. Skills themselves are tracked.
/.agents/.skill-lock.json

# Device-local config overlays and CLI deps.
/.config/ai/local/
/.config/ai/node_modules/
