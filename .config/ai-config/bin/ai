#!/usr/bin/env node

"use strict";

const crypto = require("node:crypto");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

class ConfigError extends Error {}

const LOCAL_METADATA_KEY = "__ai_config";
const SKILL_SCOPES = ["agents", "claude"];
const SKILL_DELETIONS_FILE = ".deletions.json";

let tomlModule;

function toml() {
  if (tomlModule) return tomlModule;
  try {
    tomlModule = require("smol-toml");
  } catch (error) {
    throw new ConfigError(
      "The TOML dependency is missing. Run the repository setup command again.",
      { cause: error },
    );
  }
  return tomlModule;
}

function configPaths() {
  const home = os.homedir();
  const activeRoot = process.env.AI_CONFIG_ACTIVE_HOME ?? home;
  const configRoot =
    process.env.AI_CONFIG_HOME ?? path.join(home, ".config", "ai-config");
  const stateRoot =
    process.env.AI_CONFIG_STATE_HOME ??
    path.join(home, ".local", "state", "ai-config");
  return {
    sharedClaude: path.join(configRoot, "shared", "claude.json"),
    sharedCodex: path.join(configRoot, "shared", "codex.toml"),
    localClaude: path.join(configRoot, "local", "claude.json"),
    localCodex: path.join(configRoot, "local", "codex.toml"),
    activeClaude: path.join(activeRoot, ".claude", "settings.json"),
    activeCodex: path.join(activeRoot, ".codex", "config.toml"),
    snapshotClaude: path.join(stateRoot, "last-rendered", "claude.json"),
    snapshotCodex: path.join(stateRoot, "last-rendered", "codex.toml"),
    sharedSkills: {
      agents: path.join(configRoot, "shared", "skills", "agents"),
      claude: path.join(configRoot, "shared", "skills", "claude"),
    },
    localSkills: {
      agents: path.join(configRoot, "local", "skills", "agents"),
      claude: path.join(configRoot, "local", "skills", "claude"),
    },
    activeSkills: {
      agents: path.join(activeRoot, ".agents", "skills"),
      claude: path.join(activeRoot, ".claude", "skills"),
    },
    snapshotSkills: {
      agents: path.join(stateRoot, "last-rendered", "skills", "agents"),
      claude: path.join(stateRoot, "last-rendered", "skills", "claude"),
    },
    state: path.join(stateRoot, "render-state.json"),
    lock: path.join(stateRoot, "config.lock"),
  };
}

function loadJson(file, { required = false } = {}) {
  if (!fs.existsSync(file)) {
    if (required) throw new ConfigError(`Missing shared configuration: ${file}`);
    return {};
  }
  const value = JSON.parse(fs.readFileSync(file, "utf8"));
  if (!isObject(value)) throw new ConfigError(`Expected a JSON object in ${file}`);
  return value;
}

function loadToml(file, { required = false } = {}) {
  if (!fs.existsSync(file)) {
    if (required) throw new ConfigError(`Missing shared configuration: ${file}`);
    return {};
  }
  return toml().parse(fs.readFileSync(file, "utf8"));
}

function isObject(value) {
  return value !== null && typeof value === "object" && !Array.isArray(value) && !(value instanceof Date);
}

function deepMerge(base, overlay) {
  const result = { ...base };
  for (const [key, value] of Object.entries(overlay)) {
    result[key] =
      isObject(result[key]) && isObject(value)
        ? deepMerge(result[key], value)
        : value;
  }
  return result;
}

function valuesEqual(left, right) {
  if (left instanceof Date && right instanceof Date) {
    return left.toISOString() === right.toISOString();
  }
  if (Array.isArray(left) && Array.isArray(right)) {
    return JSON.stringify(left) === JSON.stringify(right);
  }
  return left === right;
}

function validatePath(value, file) {
  if (
    !Array.isArray(value) ||
    value.length === 0 ||
    value.some((part) => typeof part !== "string" || part.length === 0)
  ) {
    throw new ConfigError(
      `Expected each deletion in ${file} to be a non-empty array of path segments.`,
    );
  }
  return value;
}

function loadLocalDocument(file, loader) {
  const document = loader(file);
  const metadata = document[LOCAL_METADATA_KEY];
  const values = { ...document };
  delete values[LOCAL_METADATA_KEY];
  if (metadata === undefined) return { values, deletions: [], replacements: [] };
  if (!isObject(metadata)) {
    throw new ConfigError(`Expected ${LOCAL_METADATA_KEY} to be an object in ${file}`);
  }
  const deletions = metadata.delete ?? [];
  const replacements = metadata.replace ?? [];
  if (!Array.isArray(deletions)) {
    throw new ConfigError(`Expected ${LOCAL_METADATA_KEY}.delete to be an array in ${file}`);
  }
  if (!Array.isArray(replacements)) {
    throw new ConfigError(`Expected ${LOCAL_METADATA_KEY}.replace to be an array in ${file}`);
  }
  return {
    values,
    deletions: deletions.map((value) => validatePath(value, file)),
    replacements: replacements.map((value) => validatePath(value, file)),
  };
}

function loadLocalLayer(paths, tool) {
  return tool === "claude"
    ? loadLocalDocument(paths.localClaude, loadJson)
    : loadLocalDocument(paths.localCodex, loadToml);
}

function isPathPrefix(prefix, value) {
  return (
    prefix.length <= value.length &&
    prefix.every((part, index) => part === value[index])
  );
}

function removeRelatedDeletions(deletions, target) {
  return deletions.filter(
    (value) => !isPathPrefix(value, target) && !isPathPrefix(target, value),
  );
}

function addDeletion(deletions, target) {
  if (deletions.some((value) => isPathPrefix(value, target))) return deletions;
  return [
    ...deletions.filter((value) => !isPathPrefix(target, value)),
    target,
  ];
}

function addReplacement(replacements, target) {
  if (replacements.some((value) => isPathPrefix(value, target))) {
    return replacements;
  }
  return [
    ...replacements.filter((value) => !isPathPrefix(target, value)),
    target,
  ];
}

function setAtPath(root, target, value) {
  let current = root;
  for (const part of target.slice(0, -1)) {
    if (!isObject(current[part])) current[part] = {};
    current = current[part];
  }
  current[target.at(-1)] = structuredClone(value);
}

function deleteAtPath(root, target) {
  const parents = [];
  let current = root;
  for (const part of target.slice(0, -1)) {
    if (!isObject(current[part])) return;
    parents.push([current, part]);
    current = current[part];
  }
  delete current[target.at(-1)];
  for (const [parent, part] of parents.reverse()) {
    if (isObject(parent[part]) && Object.keys(parent[part]).length === 0) {
      delete parent[part];
    } else {
      break;
    }
  }
}

function valueAtPath(root, target) {
  let current = root;
  for (const part of target) {
    if (!isObject(current) || !Object.hasOwn(current, part)) {
      throw new ConfigError(`No active value exists at ${target.join(".")}`);
    }
    current = current[part];
  }
  return current;
}

function hasValueAtPath(root, target) {
  let current = root;
  for (const part of target) {
    if (!isObject(current) || !Object.hasOwn(current, part)) return false;
    current = current[part];
  }
  return true;
}

function applyDeletions(value, deletions) {
  const result = structuredClone(value);
  for (const target of deletions) deleteAtPath(result, target);
  return result;
}

function applyLocalLayer(shared, layer) {
  const result = deepMerge(shared, layer.values);
  for (const target of layer.replacements) {
    setAtPath(result, target, valueAtPath(layer.values, target));
  }
  return applyDeletions(result, layer.deletions);
}

function diffOperations(current, baseline, target = []) {
  if (isObject(current) && isObject(baseline)) {
    const operations = [];
    const keys = new Set([...Object.keys(current), ...Object.keys(baseline)]);
    for (const key of keys) {
      const child = [...target, key];
      if (!Object.hasOwn(current, key)) {
        operations.push({ type: "delete", path: child });
      } else if (!Object.hasOwn(baseline, key)) {
        operations.push({ type: "set", path: child, value: current[key] });
      } else {
        operations.push(...diffOperations(current[key], baseline[key], child));
      }
    }
    return operations;
  }
  return valuesEqual(current, baseline)
    ? []
    : [{ type: "set", path: target, value: current }];
}

function writeLocalLayer(paths, tool, layer) {
  const document = structuredClone(layer.values);
  if (layer.deletions.length > 0) {
    document[LOCAL_METADATA_KEY] = { delete: layer.deletions };
  }
  if (layer.replacements.length > 0) {
    document[LOCAL_METADATA_KEY] ??= {};
    document[LOCAL_METADATA_KEY].replace = layer.replacements;
  }
  if (tool === "claude") {
    atomicWrite(paths.localClaude, `${JSON.stringify(document, null, 2)}\n`);
  } else {
    atomicWrite(paths.localCodex, toml().stringify(document));
  }
}

function writeSharedConfig(paths, tool, value) {
  if (tool === "claude") {
    atomicWrite(paths.sharedClaude, `${JSON.stringify(value, null, 2)}\n`, 0o644);
  } else {
    atomicWrite(paths.sharedCodex, toml().stringify(value), 0o644);
  }
}

function sha256(file) {
  return crypto.createHash("sha256").update(fs.readFileSync(file)).digest("hex");
}

function validateSkillName(name) {
  if (
    typeof name !== "string" ||
    name.length === 0 ||
    name.startsWith(".") ||
    name.includes("/") ||
    name.includes("\\") ||
    name === "." ||
    name === ".."
  ) {
    throw new ConfigError(`Invalid skill name: ${name}`);
  }
  return name;
}

function skillRoot(source) {
  const resolved = fs.realpathSync(source);
  if (!fs.statSync(resolved).isDirectory()) {
    throw new ConfigError(`Expected a skill directory: ${source}`);
  }
  return resolved;
}

function listSkillNames(root) {
  if (!fs.existsSync(root)) return [];
  if (!fs.statSync(root).isDirectory()) {
    throw new ConfigError(`Expected a skills directory: ${root}`);
  }
  const names = [];
  for (const entry of fs.readdirSync(root, { withFileTypes: true })) {
    if (entry.name === SKILL_DELETIONS_FILE || skillEntryIsIgnored(entry.name)) continue;
    validateSkillName(entry.name);
    const source = path.join(root, entry.name);
    if (!entry.isDirectory() && !entry.isSymbolicLink()) {
      throw new ConfigError(`Expected a skill directory: ${source}`);
    }
    skillRoot(source);
    names.push(entry.name);
  }
  return names.sort();
}

function skillDigest(source) {
  const hash = crypto.createHash("sha256");
  const root = skillRoot(source);
  function visit(directory, prefix = "") {
    const entries = fs
      .readdirSync(directory, { withFileTypes: true })
      .filter((entry) => !skillEntryIsIgnored(entry.name))
      .sort((left, right) => left.name.localeCompare(right.name));
    if (entries.length === 0) hash.update(`directory\0${prefix}\0`);
    for (const entry of entries) {
      const relative = prefix ? `${prefix}/${entry.name}` : entry.name;
      const file = path.join(directory, entry.name);
      const details = fs.lstatSync(file);
      if (entry.isDirectory()) {
        hash.update(`directory\0${relative}\0${details.mode & 0o777}\0`);
        visit(file, relative);
      } else if (entry.isFile()) {
        hash.update(`file\0${relative}\0${details.mode & 0o777}\0`);
        hash.update(fs.readFileSync(file));
        hash.update("\0");
      } else if (entry.isSymbolicLink()) {
        hash.update(`link\0${relative}\0${fs.readlinkSync(file)}\0`);
      } else {
        throw new ConfigError(`Unsupported file in skill ${source}: ${relative}`);
      }
    }
  }
  visit(root);
  return hash.digest("hex");
}

function skillEntryIsIgnored(name) {
  return name === ".DS_Store" || name === "__pycache__" || name.endsWith(".pyc");
}

function skillInventory(root) {
  return Object.fromEntries(
    listSkillNames(root).map((name) => [name, skillDigest(path.join(root, name))]),
  );
}

function skillDeletionsFile(localRoot) {
  return path.join(localRoot, SKILL_DELETIONS_FILE);
}

function loadSkillDeletions(localRoot) {
  const file = skillDeletionsFile(localRoot);
  if (!fs.existsSync(file)) return [];
  const value = JSON.parse(fs.readFileSync(file, "utf8"));
  if (!Array.isArray(value) || value.some((name) => typeof name !== "string")) {
    throw new ConfigError(`Expected an array of skill names in ${file}`);
  }
  return [...new Set(value.map(validateSkillName))].sort();
}

function writeSkillDeletions(localRoot, deletions) {
  const file = skillDeletionsFile(localRoot);
  const normalized = [...new Set(deletions.map(validateSkillName))].sort();
  if (normalized.length === 0) {
    fs.rmSync(file, { force: true });
    return;
  }
  atomicWrite(file, `${JSON.stringify(normalized, null, 2)}\n`);
}

function skillSources(paths, target) {
  const sources = new Map();
  for (const name of listSkillNames(paths.sharedSkills[target])) {
    sources.set(name, path.join(paths.sharedSkills[target], name));
  }
  for (const name of listSkillNames(paths.localSkills[target])) {
    sources.set(name, path.join(paths.localSkills[target], name));
  }
  for (const name of loadSkillDeletions(paths.localSkills[target])) {
    sources.delete(name);
  }
  return sources;
}

function effectiveSkillInventory(paths, target) {
  return Object.fromEntries(
    [...skillSources(paths, target)]
      .sort(([left], [right]) => left.localeCompare(right))
      .map(([name, source]) => [name, skillDigest(source)]),
  );
}

function copySkill(source, destination) {
  const resolved = skillRoot(source);
  fs.mkdirSync(path.dirname(destination), { recursive: true });
  fs.cpSync(resolved, destination, {
    recursive: true,
    filter: (file) => file === resolved || !skillEntryIsIgnored(path.basename(file)),
  });
}

function pathExists(file) {
  try {
    fs.lstatSync(file);
    return true;
  } catch (error) {
    if (error?.code === "ENOENT") return false;
    throw error;
  }
}

function replaceDirectory(destination, populate) {
  fs.mkdirSync(path.dirname(destination), { recursive: true });
  const token = [process.pid, crypto.randomUUID()].join(".");
  const staging = `${destination}.staging.${token}`;
  const previous = `${destination}.previous.${token}`;
  fs.mkdirSync(staging);
  let movedPrevious = false;
  try {
    populate(staging);
    if (pathExists(destination)) {
      fs.renameSync(destination, previous);
      movedPrevious = true;
    }
    fs.renameSync(staging, destination);
    if (movedPrevious) fs.rmSync(previous, { recursive: true, force: true });
  } catch (error) {
    fs.rmSync(staging, { recursive: true, force: true });
    if (movedPrevious && !fs.existsSync(destination)) {
      fs.renameSync(previous, destination);
    }
    throw error;
  }
}

function replaceSkill(source, destination) {
  const parent = path.dirname(destination);
  fs.mkdirSync(parent, { recursive: true });
  const staging = path.join(
    parent,
    "." + path.basename(destination) + ".staging." + crypto.randomUUID(),
  );
  try {
    copySkill(source, staging);
    fs.rmSync(destination, { recursive: true, force: true });
    fs.renameSync(staging, destination);
  } finally {
    fs.rmSync(staging, { recursive: true, force: true });
  }
}

function replaceSkillAlias(source, destination) {
  const parent = path.dirname(destination);
  fs.mkdirSync(parent, { recursive: true });
  const staging = path.join(
    parent,
    "." + path.basename(destination) + ".staging." + crypto.randomUUID(),
  );
  try {
    fs.symlinkSync(path.relative(parent, source), staging);
    fs.rmSync(destination, { recursive: true, force: true });
    fs.renameSync(staging, destination);
  } finally {
    fs.rmSync(staging, { force: true });
  }
}

function atomicWrite(file, content, mode = 0o600) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const temporary = path.join(
    path.dirname(file),
    `.${path.basename(file)}.${process.pid}.${crypto.randomUUID()}`,
  );
  let descriptor;
  try {
    descriptor = fs.openSync(temporary, "wx", mode);
    fs.writeFileSync(descriptor, content, "utf8");
    fs.fsyncSync(descriptor);
    fs.closeSync(descriptor);
    descriptor = undefined;
    fs.chmodSync(temporary, mode);
    fs.renameSync(temporary, file);
  } finally {
    if (descriptor !== undefined) fs.closeSync(descriptor);
    if (fs.existsSync(temporary)) fs.unlinkSync(temporary);
  }
}

function readLockOwner(file) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch (error) {
    if (error?.code === "ENOENT") return undefined;
    return null;
  }
}

function processIsRunning(pid) {
  if (!Number.isSafeInteger(pid) || pid <= 0) return false;
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error?.code === "EPERM";
  }
}

function acquireConfigLock(file) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const owner = {
    pid: process.pid,
    startedAt: new Date().toISOString(),
    token: crypto.randomUUID(),
  };

  for (let attempt = 0; attempt < 10; attempt += 1) {
    const candidate = `${file}.candidate.${owner.token}.${attempt}`;
    fs.writeFileSync(candidate, `${JSON.stringify(owner)}\n`, {
      encoding: "utf8",
      flag: "wx",
      mode: 0o600,
    });
    let acquired = false;
    try {
      fs.linkSync(candidate, file);
      acquired = true;
    } catch (error) {
      if (error?.code !== "EEXIST") throw error;
    } finally {
      fs.unlinkSync(candidate);
    }
    if (acquired) {
      return () => {
        const current = readLockOwner(file);
        if (current?.token === owner.token) fs.unlinkSync(file);
      };
    }

    const current = readLockOwner(file);
    if (current && processIsRunning(current.pid)) {
      throw new ConfigError(
        `Another ai configuration command is running (PID ${current.pid}, started ${current.startedAt ?? "at an unknown time"}).`,
      );
    }
    if (current === null) {
      let age;
      try {
        age = Date.now() - fs.statSync(file).mtimeMs;
      } catch (error) {
        if (error?.code === "ENOENT") continue;
        throw error;
      }
      if (age < 30_000) {
        throw new ConfigError(
          `The configuration lock is not readable yet: ${file}. Try again.`,
        );
      }
    }

    const stale = `${file}.stale.${crypto.randomUUID()}`;
    try {
      fs.renameSync(file, stale);
      fs.unlinkSync(stale);
    } catch (error) {
      if (error?.code !== "ENOENT") throw error;
    }
  }
  throw new ConfigError(`Could not acquire the configuration lock: ${file}`);
}

function withConfigLock(callback) {
  const release = acquireConfigLock(configPaths().lock);
  try {
    return callback();
  } finally {
    release();
  }
}

function loadState(file) {
  return fs.existsSync(file) ? loadJson(file) : { outputs: {} };
}

function assertNoDrift(paths) {
  const state = loadState(paths.state);
  const outputs = state.outputs ?? {};
  for (const key of ["activeClaude", "activeCodex"]) {
    const file = paths[key];
    if (!fs.existsSync(file)) continue;
    const expected = outputs[file];
    if (!expected) {
      throw new ConfigError(
        `Existing unmanaged configuration: ${file}\n` +
          "Run `ai capture` once to preserve it as local configuration.",
      );
    }
    if (sha256(file) !== expected) {
      throw new ConfigError(
        `Configuration changed after the last render: ${file}\n` +
          "Run `ai capture` to keep the change, or restore the generated file.",
      );
    }
  }
  for (const target of SKILL_SCOPES) {
    const current = skillInventory(paths.activeSkills[target]);
    const expected = state.skills?.[target];
    if (expected === undefined) {
      if (Object.keys(current).length > 0) {
        throw new ConfigError(
          `Existing unmanaged skills: ${paths.activeSkills[target]}\n` +
            "Run `ai capture` once to preserve them as local skills.",
        );
      }
      continue;
    }
    if (JSON.stringify(current) !== JSON.stringify(expected)) {
      throw new ConfigError(
        `Skills changed after the last render: ${paths.activeSkills[target]}\n` +
          "Run `ai capture` to keep the changes, or restore the generated skills.",
      );
    }
  }
}

function renderedValues(paths) {
  return {
    claude: applyLocalLayer(
      loadJson(paths.sharedClaude, { required: true }),
      loadLocalLayer(paths, "claude"),
    ),
    codex: applyLocalLayer(
      loadToml(paths.sharedCodex, { required: true }),
      loadLocalLayer(paths, "codex"),
    ),
  };
}

function render({ force = false, quiet = false } = {}) {
  const paths = configPaths();
  if (!force) assertNoDrift(paths);
  const { claude, codex } = renderedValues(paths);
  for (const target of SKILL_SCOPES) effectiveSkillInventory(paths, target);
  const claudeText = `${JSON.stringify(claude, null, 2)}\n`;
  const codexText = toml().stringify(codex);
  JSON.parse(claudeText);
  toml().parse(codexText);
  atomicWrite(paths.activeClaude, claudeText);
  atomicWrite(paths.activeCodex, codexText);
  atomicWrite(paths.snapshotClaude, claudeText);
  atomicWrite(paths.snapshotCodex, codexText);
  for (const target of SKILL_SCOPES) {
    const sources = skillSources(paths, target);
    replaceDirectory(paths.activeSkills[target], (staging) => {
      for (const [name, source] of sources) {
        copySkill(source, path.join(staging, name));
      }
    });
    replaceDirectory(paths.snapshotSkills[target], (staging) => {
      for (const name of listSkillNames(paths.activeSkills[target])) {
        copySkill(
          path.join(paths.activeSkills[target], name),
          path.join(staging, name),
        );
      }
    });
  }
  atomicWrite(
    paths.state,
    `${JSON.stringify(
      {
        outputs: {
          [paths.activeClaude]: sha256(paths.activeClaude),
          [paths.activeCodex]: sha256(paths.activeCodex),
        },
        skills: Object.fromEntries(
          SKILL_SCOPES.map((target) => [
            target,
            skillInventory(paths.activeSkills[target]),
          ]),
        ),
      },
      null,
      2,
    )}\n`,
  );
  if (!quiet) console.log("Rendered Claude and Codex configuration and skills.");
}

function adoptTool(paths, tool) {
  const isClaude = tool === "claude";
  const activeFile = isClaude ? paths.activeClaude : paths.activeCodex;
  if (!fs.existsSync(activeFile)) return;
  const sharedFile = isClaude ? paths.sharedClaude : paths.sharedCodex;
  const snapshotFile = isClaude ? paths.snapshotClaude : paths.snapshotCodex;
  const loader = isClaude ? loadJson : loadToml;
  const shared = loader(sharedFile, { required: true });
  const layer = loadLocalLayer(paths, tool);
  const hasSnapshot = fs.existsSync(snapshotFile);
  const baseline = hasSnapshot
    ? loader(snapshotFile, { required: true })
    : applyLocalLayer(shared, layer);
  const current = loader(activeFile, { required: true });
  const operations = diffOperations(current, baseline).filter(
    (operation) => hasSnapshot || operation.type !== "delete",
  );
  if (operations.length === 0) return;
  for (const operation of operations) {
    if (operation.type === "set") {
      setAtPath(layer.values, operation.path, operation.value);
      layer.deletions = removeRelatedDeletions(layer.deletions, operation.path);
      layer.replacements = removeRelatedDeletions(
        layer.replacements,
        operation.path,
      );
      if (isObject(operation.value)) {
        layer.replacements = addReplacement(layer.replacements, operation.path);
      }
    } else {
      deleteAtPath(layer.values, operation.path);
      layer.deletions = addDeletion(layer.deletions, operation.path);
      layer.replacements = removeRelatedDeletions(
        layer.replacements,
        operation.path,
      );
    }
  }
  writeLocalLayer(paths, tool, layer);
}

function adoptSkillTarget(paths, target) {
  const activeRoot = paths.activeSkills[target];
  const localRoot = paths.localSkills[target];
  const snapshotRoot = paths.snapshotSkills[target];
  const current = skillInventory(activeRoot);
  const hasSnapshot = fs.existsSync(snapshotRoot);
  const baseline = hasSnapshot
    ? skillInventory(snapshotRoot)
    : effectiveSkillInventory(paths, target);
  let deletions = loadSkillDeletions(localRoot);
  const names = [...new Set([...Object.keys(current), ...Object.keys(baseline)])].sort();
  for (const name of names) {
    if (current[name] !== undefined && current[name] !== baseline[name]) {
      replaceSkill(
        path.join(activeRoot, name),
        path.join(localRoot, name),
      );
      deletions = deletions.filter((value) => value !== name);
    } else if (
      hasSnapshot &&
      current[name] === undefined &&
      baseline[name] !== undefined
    ) {
      fs.rmSync(path.join(localRoot, name), { recursive: true, force: true });
      if (!deletions.includes(name)) deletions.push(name);
    }
  }
  writeSkillDeletions(localRoot, deletions);
}

function adopt({ quiet = false } = {}) {
  const paths = configPaths();
  adoptTool(paths, "claude");
  adoptTool(paths, "codex");
  for (const target of SKILL_SCOPES) adoptSkillTarget(paths, target);
  render({ force: true, quiet });
  if (!quiet) {
    console.log("Preserved existing device values and skills in the local layers.");
  }
}

function parseToolAndPath(args) {
  const [tool, ...target] = args;
  if (tool !== "claude" && tool !== "codex") {
    throw new ConfigError("The configuration tool must be `claude` or `codex`.");
  }
  validatePath(target, "command path");
  return { tool, target };
}

function editLocalConfig(tool, target, edit) {
  adopt({ quiet: true });
  const paths = configPaths();
  const layer = loadLocalLayer(paths, tool);
  edit(layer, paths);
  writeLocalLayer(paths, tool, layer);
  render();
}

function pinConfig(args) {
  const optionIndex = args.findIndex(
    (value) => value === "--value" || value === "--json-value",
  );
  let commandArgs = args;
  let suppliedValue;
  if (optionIndex !== -1) {
    if (optionIndex !== args.length - 2) {
      throw new ConfigError("Put `--value` or `--json-value` before one final value.");
    }
    const option = args[optionIndex];
    const rawValue = args.at(-1);
    commandArgs = args.slice(0, optionIndex);
    suppliedValue = option === "--value" ? rawValue : JSON.parse(rawValue);
    if (suppliedValue === null) {
      throw new ConfigError("Use `ai remove` instead of a null value.");
    }
  }
  const { tool, target } = parseToolAndPath(commandArgs);
  editLocalConfig(tool, target, (layer, paths) => {
    let value = suppliedValue;
    if (optionIndex === -1) {
      const activeFile = tool === "claude" ? paths.activeClaude : paths.activeCodex;
      const loader = tool === "claude" ? loadJson : loadToml;
      value = valueAtPath(loader(activeFile, { required: true }), target);
    }
    setAtPath(layer.values, target, value);
    layer.deletions = removeRelatedDeletions(layer.deletions, target);
    layer.replacements = removeRelatedDeletions(layer.replacements, target);
    if (isObject(value)) {
      layer.replacements = addReplacement(layer.replacements, target);
    }
  });
  console.log(`Pinned ${tool}.${target.join(".")}.`);
}

function resetConfig(args) {
  const { tool, target } = parseToolAndPath(args);
  editLocalConfig(tool, target, (layer) => {
    deleteAtPath(layer.values, target);
    layer.deletions = removeRelatedDeletions(layer.deletions, target);
    layer.replacements = removeRelatedDeletions(layer.replacements, target);
  });
  console.log(`Reset ${tool}.${target.join(".")} to shared configuration.`);
}

function removeConfig(args) {
  const { tool, target } = parseToolAndPath(args);
  editLocalConfig(tool, target, (layer) => {
    deleteAtPath(layer.values, target);
    layer.deletions = addDeletion(layer.deletions, target);
    layer.replacements = removeRelatedDeletions(layer.replacements, target);
  });
  console.log(`Deleted ${tool}.${target.join(".")} from the effective configuration.`);
}

function hasStrictAncestor(paths, target) {
  return paths.some(
    (value) => value.length < target.length && isPathPrefix(value, target),
  );
}

function hasLocalIntent(layer, target) {
  return (
    hasValueAtPath(layer.values, target) ||
    layer.deletions.some(
      (value) => isPathPrefix(value, target) || isPathPrefix(target, value),
    ) ||
    layer.replacements.some(
      (value) => isPathPrefix(value, target) || isPathPrefix(target, value),
    )
  );
}

function shareConfig(args) {
  const { tool, target } = parseToolAndPath(args);
  adopt({ quiet: true });
  const paths = configPaths();
  const layer = loadLocalLayer(paths, tool);
  if (!hasLocalIntent(layer, target)) {
    throw new ConfigError(`No local setting exists at ${tool}.${target.join(".")}.`);
  }
  if (
    hasStrictAncestor(layer.deletions, target) ||
    hasStrictAncestor(layer.replacements, target)
  ) {
    throw new ConfigError(
      "Share the parent path because it owns the local delete or exact-object intent.",
    );
  }

  const isClaude = tool === "claude";
  const sharedFile = isClaude ? paths.sharedClaude : paths.sharedCodex;
  const loader = isClaude ? loadJson : loadToml;
  const shared = loader(sharedFile, { required: true });
  const effective = applyLocalLayer(shared, layer);
  if (hasValueAtPath(effective, target)) {
    setAtPath(shared, target, valueAtPath(effective, target));
  } else {
    deleteAtPath(shared, target);
  }

  deleteAtPath(layer.values, target);
  layer.deletions = layer.deletions.filter(
    (value) => !isPathPrefix(target, value),
  );
  layer.replacements = layer.replacements.filter(
    (value) => !isPathPrefix(target, value),
  );
  writeSharedConfig(paths, tool, shared);
  writeLocalLayer(paths, tool, layer);
  render();
  console.log(
    `Shared ${tool}.${target.join(".")} locally. Commit and push the tracked change to synchronize devices.`,
  );
}

function parseSkillTarget(args) {
  const [target, rawName, ...extra] = args;
  if (!SKILL_SCOPES.includes(target)) {
    throw new ConfigError("The skill target must be `agents` or `claude`.");
  }
  if (rawName === undefined || extra.length > 0) {
    throw new ConfigError("Use one skill name after the skill target.");
  }
  return { target, name: validateSkillName(rawName) };
}

function removeSkillDeletion(paths, target, name) {
  const localRoot = paths.localSkills[target];
  writeSkillDeletions(
    localRoot,
    loadSkillDeletions(localRoot).filter((value) => value !== name),
  );
}

function pinSkill(args) {
  const { target, name } = parseSkillTarget(args);
  adopt({ quiet: true });
  const paths = configPaths();
  const active = path.join(paths.activeSkills[target], name);
  if (!fs.existsSync(active)) {
    throw new ConfigError(`No active ${target} skill exists named ${name}.`);
  }
  replaceSkill(active, path.join(paths.localSkills[target], name));
  removeSkillDeletion(paths, target, name);
  render();
  console.log(`Pinned ${target} skill ${name} on this device.`);
}

function resetSkill(args) {
  const { target, name } = parseSkillTarget(args);
  adopt({ quiet: true });
  const paths = configPaths();
  fs.rmSync(path.join(paths.localSkills[target], name), {
    recursive: true,
    force: true,
  });
  removeSkillDeletion(paths, target, name);
  render();
  console.log(`Reset ${target} skill ${name} to the shared layer.`);
}

function removeSkill(args) {
  const { target, name } = parseSkillTarget(args);
  adopt({ quiet: true });
  const paths = configPaths();
  const localRoot = paths.localSkills[target];
  fs.rmSync(path.join(localRoot, name), { recursive: true, force: true });
  const deletions = loadSkillDeletions(localRoot);
  if (!deletions.includes(name)) deletions.push(name);
  writeSkillDeletions(localRoot, deletions);
  render();
  console.log(`Removed ${target} skill ${name} on this device.`);
}

function detachSharedSkillAliases(paths, target, name) {
  const source = path.join(paths.sharedSkills[target], name);
  if (!pathExists(source)) return;
  const resolvedSource = fs.realpathSync(source);
  for (const otherTarget of SKILL_SCOPES) {
    if (otherTarget === target) continue;
    const candidate = path.join(paths.sharedSkills[otherTarget], name);
    if (
      !pathExists(candidate) ||
      !fs.lstatSync(candidate).isSymbolicLink()
    ) {
      continue;
    }
    if (fs.realpathSync(candidate) === resolvedSource) {
      replaceSkill(candidate, candidate);
    }
  }
}

function shareSkill(args) {
  const { target, name } = parseSkillTarget(args);
  adopt({ quiet: true });
  const paths = configPaths();
  const localRoot = paths.localSkills[target];
  const local = path.join(localRoot, name);
  const shared = path.join(paths.sharedSkills[target], name);
  const deletions = loadSkillDeletions(localRoot);
  detachSharedSkillAliases(paths, target, name);
  if (deletions.includes(name)) {
    fs.rmSync(shared, { recursive: true, force: true });
  } else if (fs.existsSync(local)) {
    const matchingShared = SKILL_SCOPES
      .filter((value) => value !== target)
      .map((value) => path.join(paths.sharedSkills[value], name))
      .find(
        (candidate) =>
          pathExists(candidate) && skillDigest(candidate) === skillDigest(local),
      );
    if (matchingShared === undefined) {
      replaceSkill(local, shared);
    } else {
      replaceSkillAlias(matchingShared, shared);
    }
  } else {
    throw new ConfigError(`No local ${target} skill exists named ${name}.`);
  }
  fs.rmSync(local, { recursive: true, force: true });
  writeSkillDeletions(
    localRoot,
    deletions.filter((value) => value !== name),
  );
  render();
  console.log(
    `Shared ${target} skill ${name} locally. Commit and push the tracked change to synchronize devices.`,
  );
}

function skillsCommand(args) {
  const [command, ...commandArgs] = args;
  switch (command) {
    case "pin":
      return pinSkill(commandArgs);
    case "reset":
      return resetSkill(commandArgs);
    case "remove":
      return removeSkill(commandArgs);
    case "share":
      return shareSkill(commandArgs);
    default:
      throw new ConfigError(
        "Use `ai skills pin`, `reset`, `remove`, or `share`.",
      );
  }
}

function configStatus() {
  const paths = configPaths();
  const outputs = loadState(paths.state).outputs ?? {};
  for (const key of ["activeClaude", "activeCodex"]) {
    const file = paths[key];
    let condition;
    if (!fs.existsSync(file)) condition = "missing";
    else if (outputs[file] === sha256(file)) condition = "current";
    else if (Object.hasOwn(outputs, file)) condition = "changed";
    else condition = "unmanaged";
    console.log(`${file}: ${condition}`);
  }
}

function skillsStatus(paths) {
  const state = loadState(paths.state);
  for (const target of SKILL_SCOPES) {
    const current = skillInventory(paths.activeSkills[target]);
    const expected = state.skills?.[target];
    let condition;
    if (expected === undefined) {
      condition = Object.keys(current).length === 0 ? "missing" : "unmanaged";
    } else if (JSON.stringify(current) === JSON.stringify(expected)) {
      condition = "current";
    } else {
      condition = "changed";
    }
    console.log(`${paths.activeSkills[target]}: ${condition}`);
  }
}

function hasAnyLocalIntent(layer) {
  return (
    Object.keys(layer.values).length > 0 ||
    layer.deletions.length > 0 ||
    layer.replacements.length > 0
  );
}

function status() {
  const paths = configPaths();
  console.log("Active configuration:");
  configStatus();
  console.log("Active skills:");
  skillsStatus(paths);
  console.log("Local intent:");
  console.log(
    `${paths.localClaude}: ${hasAnyLocalIntent(loadLocalLayer(paths, "claude")) ? "present" : "none"}`,
  );
  console.log(
    `${paths.localCodex}: ${hasAnyLocalIntent(loadLocalLayer(paths, "codex")) ? "present" : "none"}`,
  );
  for (const target of SKILL_SCOPES) {
    const names = listSkillNames(paths.localSkills[target]);
    const deletions = loadSkillDeletions(paths.localSkills[target]);
    console.log(
      `${paths.localSkills[target]}: ${names.length} override(s), ${deletions.length} deletion(s)`,
    );
  }
  console.log("Tracked shared changes:");
  return runGit([
    "status",
    "--short",
    "--",
    ".config/ai-config/shared/claude.json",
    ".config/ai-config/shared/codex.toml",
    ".config/ai-config/shared/skills",
  ]);
}

function runGit(args) {
  const gitDir = process.env.AI_CONFIG_GIT_DIR ?? path.join(os.homedir(), ".ai-config");
  const workTree = process.env.AI_CONFIG_WORK_TREE ?? os.homedir();
  const result = spawnSync(
    "git",
    [`--git-dir=${gitDir}`, `--work-tree=${workTree}`, ...args],
    { cwd: workTree, stdio: "inherit" },
  );
  if (result.error) throw result.error;
  return result.status ?? 1;
}

function main() {
  const [command, ...args] = process.argv.slice(2);
  switch (command) {
    case "sync": {
      return withConfigLock(() => {
        adopt({ quiet: true });
        const result = runGit(["pull", "--ff-only", ...args]);
        if (result !== 0) return result;
        render();
        return 0;
      });
    }
    case "status":
      return status();
    case "apply":
      return withConfigLock(() => {
        render();
        return 0;
      });
    case "capture":
      return withConfigLock(() => {
        adopt();
        return 0;
      });
    case "pin":
      return withConfigLock(() => {
        pinConfig(args);
        return 0;
      });
    case "reset":
      return withConfigLock(() => {
        resetConfig(args);
        return 0;
      });
    case "remove":
      return withConfigLock(() => {
        removeConfig(args);
        return 0;
      });
    case "share":
      return withConfigLock(() => {
        shareConfig(args);
        return 0;
      });
    case "skills":
      return withConfigLock(() => {
        skillsCommand(args);
        return 0;
      });
    case "git":
      return runGit(args);
    default:
      throw new ConfigError(
        "Use `ai sync`, `status`, `apply`, `capture`, `pin`, `reset`, `remove`, `share`, `skills`, or `git`.",
      );
  }
}

try {
  process.exitCode = main();
} catch (error) {
  console.error(`ai: ${error instanceof Error ? error.message : String(error)}`);
  process.exitCode = 1;
}
